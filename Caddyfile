{
	email admin@{$DOMAIN:jagoqui.tech}
}

# Every downstream hop (forward_auth and the final upstream) strips these
# inbound headers first so a client can never spoof gateway-issued identity
# or the brokered Atlassian credential. auth-gateway's /verify response is
# the only legitimate source for them (see copy_headers below).
(strip_gateway_headers) {
	header_up -X-Gateway-User
	header_up -X-Gateway-User-Id
	header_up -X-Atlassian-Authorization
}

{$DOMAIN:jagoqui.tech} {
	handle /mcp/context7* {
		forward_auth auth-gateway:3000 {
			uri /verify
			import strip_gateway_headers
			copy_headers X-Gateway-User X-Gateway-User-Id
		}
		reverse_proxy mcp-context7:9000
	}

	handle /mcp/atlassian* {
		forward_auth auth-gateway:3000 {
			uri /verify
			import strip_gateway_headers
			copy_headers X-Gateway-User X-Gateway-User-Id X-Atlassian-Authorization
		}
		reverse_proxy mcp-atlassian:9000 {
			# Promote the per-user Atlassian credential auth-gateway emitted
			# on /verify into the real Authorization header for this route
			# only, then remove the intermediate header before it leaves.
			header_up Authorization {header.X-Atlassian-Authorization}
			header_up -X-Atlassian-Authorization
		}
	}

	handle /mcp/engram* {
		forward_auth auth-gateway:3000 {
			uri /verify
			import strip_gateway_headers
			copy_headers X-Gateway-User X-Gateway-User-Id
		}
		# engram-router derives its Engram Cloud project ONLY from
		# X-Gateway-User (copied above) — never from anything else in the
		# request. See openspec/changes/engram-remote-mcp.
		reverse_proxy engram-router:9000
	}

	handle {
		respond "mcp-gateway" 200
	}
}

auth.{$DOMAIN:jagoqui.tech} {
	# /login and /verify are auth-gateway's own public entry points and
	# MUST stay reachable without a prior forward_auth check.
	handle /login* {
		reverse_proxy auth-gateway:3000 {
			import strip_gateway_headers
		}
	}

	handle /verify* {
		reverse_proxy auth-gateway:3000 {
			import strip_gateway_headers
		}
	}

	handle {
		forward_auth auth-gateway:3000 {
			uri /verify
			import strip_gateway_headers
			copy_headers X-Gateway-User X-Gateway-User-Id
		}
		reverse_proxy auth-gateway:3000
	}
}

# Consolidated onto engram-cloud.{$DOMAIN}/monitor (single domain, single
# login per user request — see that block below) instead of its own host.
# Kept as a redirect, not removed, so existing bookmarks/links still land
# somewhere real.
monitor.{$DOMAIN:jagoqui.tech} {
	redir https://engram-cloud.{$DOMAIN:jagoqui.tech}/monitor{uri} permanent
}

# `engram cloud serve` has its own real Bearer-token auth (ENGRAM_CLOUD_TOKEN),
# team-wide (one shared token for everyone, not per-user like /mcp/atlassian).
# /health and /sync/* MUST stay carved out of our own forward_auth below: the
# `engram` CLI's sync client sends a single Authorization header carrying
# ENGRAM_CLOUD_TOKEN, which forward_auth would reject as an invalid gateway
# token, breaking sync entirely — same carve-out reasoning as auth.{$DOMAIN}'s
# /login and /verify. Verified directly against the running container,
# including the real client workflow (`engram cloud config` / `enroll` are
# local-only, no server call at all — confirmed by running them against a
# real cloud sync target with a deliberately wrong token: no rejection,
# because nothing was sent over the wire; the actual server round-trip only
# happens on `engram sync --cloud`, which DID reject that same wrong token
# with "401: unauthorized: unknown token").
#
# Everything else on this domain — /dashboard (redirects to its own
# /dashboard/login) AND /monitor (engram-monitor, built with
# VITE_BASE_PATH=/monitor/ — see services/engram-monitor/Dockerfile) —
# sits behind the same admin session (single perimeter, single domain per
# user request): an unauthenticated visitor can no longer even reach
# Cloud's own login screen. Cloud's own token prompt still appears as a
# second step after /dashboard specifically — there is no partial-disable
# of ENGRAM_CLOUD_INSECURE_NO_AUTH (it's all-or-nothing for the whole
# process, /sync/* included), so a true single-step login for /dashboard
# would require auto-relaying a real per-user or the shared wildcard token
# into Cloud's own /dashboard/login, which needs a secret this Caddyfile
# has no access to. See openspec/changes/engram-unified-console.
engram-cloud.{$DOMAIN:jagoqui.tech} {
	handle /health* {
		reverse_proxy engram-cloud:18080
	}

	handle /sync/* {
		reverse_proxy engram-cloud:18080
	}

	# Same carve-out reasoning as auth.{$DOMAIN}'s /login and /verify —
	# /admin/login MUST stay reachable without a prior forward_auth check,
	# or the gate below locks out its own login page. Straight to
	# auth-gateway, not engram-cloud:18080 — there's no nginx layer in
	# front of this host's /dashboard side to route it through.
	handle /admin/login* {
		reverse_proxy auth-gateway:3000
	}

	# admin-users-panel's Unit 8-11 routes (users list/create,
	# disable/enable, token list/issue/revoke/regenerate) — everything
	# under /admin/* except /admin/login* above. Without this block they'd
	# fall into the catch-all below and hit engram-cloud:18080, which has
	# no idea what /admin/users means. GET /admin/verify itself needs no
	# entry here — forward_auth calls it as an internal subrequest, never
	# a publicly routed path.
	handle /admin/* {
		forward_auth auth-gateway:3000 {
			uri /admin/verify
			import strip_gateway_headers
		}
		reverse_proxy auth-gateway:3000
	}

	# Full path forwarded as-is (no stripping) — engram-monitor's own
	# nginx.conf matches on /monitor/* directly, since its build already
	# has that same prefix baked into every asset reference.
	handle /monitor* {
		forward_auth auth-gateway:3000 {
			uri /admin/verify
			import strip_gateway_headers
		}
		reverse_proxy engram-monitor:80
	}

	handle {
		forward_auth auth-gateway:3000 {
			uri /admin/verify
			import strip_gateway_headers
		}
		reverse_proxy engram-cloud:18080
	}
}
