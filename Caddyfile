{
	email admin@{$DOMAIN:jagoqui.tech}
}

# Every downstream hop (forward_auth and the final upstream) strips these
# inbound headers first so a client can never spoof gateway-issued identity
# or the brokered Atlassian credential. auth-gateway's /verify response is
# the only legitimate source for them (see copy_headers below).
(strip_gateway_headers) {
	header_up -X-Gateway-User
	header_up -X-Gateway-User-Id
	header_up -X-Atlassian-Authorization
}

{$DOMAIN:jagoqui.tech} {
	handle /mcp/context7* {
		forward_auth auth-gateway:3000 {
			uri /verify
			import strip_gateway_headers
			copy_headers X-Gateway-User X-Gateway-User-Id
		}
		reverse_proxy mcp-context7:9000
	}

	handle /mcp/atlassian* {
		forward_auth auth-gateway:3000 {
			uri /verify
			import strip_gateway_headers
			copy_headers X-Gateway-User X-Gateway-User-Id X-Atlassian-Authorization
		}
		reverse_proxy mcp-atlassian:9000 {
			# Promote the per-user Atlassian credential auth-gateway emitted
			# on /verify into the real Authorization header for this route
			# only, then remove the intermediate header before it leaves.
			header_up Authorization {header.X-Atlassian-Authorization}
			header_up -X-Atlassian-Authorization
		}
	}

	handle /mcp/engram* {
		forward_auth auth-gateway:3000 {
			uri /verify
			import strip_gateway_headers
			copy_headers X-Gateway-User X-Gateway-User-Id
		}
		reverse_proxy mcp-engram-tool:9000
	}

	handle {
		respond "mcp-gateway" 200
	}
}

auth.{$DOMAIN:jagoqui.tech} {
	# /login and /verify are auth-gateway's own public entry points and
	# MUST stay reachable without a prior forward_auth check.
	handle /login* {
		reverse_proxy auth-gateway:3000 {
			import strip_gateway_headers
		}
	}

	handle /verify* {
		reverse_proxy auth-gateway:3000 {
			import strip_gateway_headers
		}
	}

	handle {
		forward_auth auth-gateway:3000 {
			uri /verify
			import strip_gateway_headers
			copy_headers X-Gateway-User X-Gateway-User-Id
		}
		reverse_proxy auth-gateway:3000
	}
}

# engram-monitor and the host's `engram serve` API are deliberately NOT
# published here. engram-monitor's browser client sends no auth credentials
# at all (see README.md's "engram-monitor backend" section), so gating its
# API behind forward_auth would 401 every request, and exposing plain
# `engram serve` (read + delete + import/migrate) on the public internet
# with no auth would break this stack's single-perimeter guarantee. Access
# both locally via an SSH tunnel instead — see the README section above.

# Unlike plain `engram serve`, `engram cloud serve` has its own real
# Bearer-token auth (ENGRAM_CLOUD_TOKEN) — safe to expose directly. Deliberately
# NOT wrapped in our own forward_auth: the `engram` CLI's own sync client sends
# a single Authorization header carrying ENGRAM_CLOUD_TOKEN, which forward_auth
# would reject as an invalid gateway token, breaking sync entirely. This is
# team-wide (one shared token for everyone, not per-user like /mcp/atlassian).
# Verified directly against the running container before exposing this,
# including the real client workflow documented below (`engram cloud
# config` / `enroll` are local-only, no server call at all — confirmed by
# running them against a real cloud sync target with a deliberately wrong
# token: no rejection, because nothing was sent over the wire; the actual
# server round-trip only happens on `engram sync --cloud`, which DID
# reject that same wrong token with "401: unauthorized: unknown token").
# /health is open (status only, no data), /dashboard redirects to its own
# /dashboard/login, and /sync/pull and /sync/push — the same surface the
# real `sync --cloud` manifest-fetch call hit above — both return 401
# without a valid token.
engram-cloud.{$DOMAIN:jagoqui.tech} {
	reverse_proxy engram-cloud-1:18080
}

# engram-monitor is now published behind forward_auth instead of the
# SSH-tunnel-only access described above — its own client still sends no
# auth credentials, so gating happens entirely at this edge, in front of the
# unauthenticated app. /engram-verify (below) is what issues the session
# cookie forward_auth checks here; engram-hub.{$DOMAIN} (further below) is
# where a human obtains one. reverse_proxy targets host.docker.internal
# (see docker-compose.yml's extra_hosts on the caddy service), not a
# gateway-network service name: engram-monitor still runs with
# network_mode: host (its nginx now listens on 0.0.0.0:7438 instead of
# 127.0.0.1:7438, see services/engram-monitor/nginx.conf) because the
# host's `engram serve` it proxies to stays bound to 127.0.0.1 only.
engram-monitor.{$DOMAIN:jagoqui.tech} {
	forward_auth auth-gateway:3000 {
		uri /engram-verify
	}
	reverse_proxy host.docker.internal:7438
}

# engram-hub is the shared-token login front door for the two dashboards
# above: engram-monitor (gated by forward_auth /engram-verify, immediately
# above) and engram-cloud's own dashboard (which keeps its own separate
# login — this page only relays the typed token into it via a top-level
# form POST, it never shares a cookie with it). /engram-verify* is
# reverse-proxied here (not behind its own forward_auth, same reasoning as
# auth.{$DOMAIN}'s /login*/ /verify* above: it has to be reachable by an
# unauthenticated browser to be useful) so this same origin can POST a
# token and receive the engram_hub_session cookie, scoped with a
# leading-dot Domain= so engram-monitor.{$DOMAIN} accepts it too. Every
# other path serves the static single-file front end from /srv/hub (bind
# -mounted read-only in docker-compose.yml, mirroring how ./Caddyfile
# itself is mounted).
engram-hub.{$DOMAIN:jagoqui.tech} {
	handle /engram-verify* {
		reverse_proxy auth-gateway:3000
	}
	handle {
		root * /srv/hub
		file_server
	}
}
