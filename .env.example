# Copy to .env and fill in real values. .env is gitignored; never commit it.

# --- Reverse proxy / TLS ---------------------------------------------------
# Base domain. Backend services are routed under the auth. subdomain and
# under path prefixes on the apex (<DOMAIN>/mcp/context7, /mcp/atlassian,
# /mcp/engram). Caddy issues TLS certificates for these hosts automatically;
# DNS A records must exist first.
DOMAIN=jagoqui.tech

# --- auth-gateway -----------------------------------------------------------
# 32 random bytes, base64-encoded. Used for AES-256-GCM encryption of stored
# per-user Atlassian credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATLASSIAN_ENC_KEY=

# --- mcp-context7 -----------------------------------------------------------
CONTEXT7_API_KEY=

# --- mcp-atlassian ------------------------------------------------------
# Base URL of your Atlassian site (Cloud or Server/DC). Per-user PATs are
# brokered by auth-gateway and injected per request; this is only the
# shared site URL the tool needs to know where to call.
ATLASSIAN_URL=

# --- engram-router --------------------------------------------------------
# Per-identity Streamable HTTP bridge (replaces the old single-project
# mcp-engram-tool). Spawns one engram mcp child per authenticated gateway
# user, autosyncing each to engram-cloud below. Uses the SAME legacy token
# as ENGRAM_CLOUD_TOKEN further down this file — engram-cloud's own auth
# must accept it, deliberately the legacy (not managed-principal) model,
# since only that model allows sync for a project it has never seen
# before (managed tokens are deny-by-default, no wildcard). No separate
# var needed here; ENGRAM_CLOUD_TOKEN is reused by both sides.
# Optional tuning (defaults shown are also the code's own defaults):
# MAX_ENGRAM_CHILDREN=20

# --- auth-gateway sessions ---------------------------------------------
# 32+ random bytes, used to sign HttpOnly session cookies issued by
# POST /login. Generate with:
#   openssl rand -base64 32
AUTH_GATEWAY_SESSION_SECRET=

# --- auth-gateway admin panel ---------------------------------------------
# 32+ random bytes, signs the __Host-admin_session cookie for the admin
# users panel (README.md's "Admin users panel" section) — a DISTINCT
# secret from AUTH_GATEWAY_SESSION_SECRET above, never the same value.
# Generate the same way:
#   openssl rand -base64 32
AUTH_GATEWAY_ADMIN_SESSION_SECRET=

# --- engram-cloud (`engram cloud serve`, port 18080) --------------------
# Team memory instance (Postgres-backed sync). Unrelated to engram-monitor
# below — different service, different API, not routed through Caddy;
# reached only internally by engram-router (above).
ENGRAM_CLOUD_TOKEN=
ENGRAM_CLOUD_ADMIN=
# 32+ random bytes (base64) -- engram-cloud ENGRAM_CLOUD_TOKEN_PEPPER. Required
# for managed-token auth (ENGRAM_CLOUD_ADMIN_TOKEN below); without it engram-cloud
# falls back to the legacy ENGRAM_CLOUD_ADMIN token above, which every
# /admin/* route rejects. Generate the same way as AUTH_GATEWAY_SESSION_SECRET.
ENGRAM_CLOUD_TOKEN_PEPPER=

# Real MANAGED admin token for engram-cloud /admin/* API (consumed by
# auth-gateway, proxied from the admin panel). NOT the same value as
# ENGRAM_CLOUD_ADMIN above -- that is the legacy env-fallback token,
# rejected on /admin/* routes. Issue with:
#   engram cloud bootstrap admin --username <name> --issue-token
# or, if an admin exists with no token:
#   engram cloud bootstrap recover-token
ENGRAM_CLOUD_ADMIN_TOKEN=
ENGRAM_JWT_SECRET=
# MUST be exactly "*" (not a comma-separated list) — engram-router's whole
# point is onboarding a brand-new project with zero admin action per user,
# which only this legacy wildcard model supports.
ENGRAM_CLOUD_ALLOWED_PROJECTS=*

# --- engram-cloud-db (postgres backing engram-cloud) --------------------
ENGRAM_CLOUD_DB_USER=engram
ENGRAM_CLOUD_DB_PASSWORD=
ENGRAM_CLOUD_DB_NAME=engram_cloud

# --- engram-monitor -------------------------------------------------------
# Build-time only (Vite bakes this into the JS bundle — changing it
# requires rebuilding the engram-monitor image, it is NOT read at
# container runtime).
#
# NOT published through Caddy or DNS: engram-monitor's browser client
# sends no auth credentials at all, so it can't sit behind forward_auth
# (every request would 401), and the plain `engram serve` API it calls
# has no auth of its own to safely expose on the public internet instead
# (it includes delete/import/migrate endpoints). engram-monitor is
# published on the VPS's own loopback only (127.0.0.1:7438); reach it via
# an SSH tunnel of that port together with 7437 (engram serve itself,
# which this default value points at) — see README.md's "engram-monitor
# backend" section.
VITE_ENGRAM_URL=http://127.0.0.1:7437

# --- Optional: pin the engram binary release instead of resolving `latest`
# ENGRAM_VERSION=
