# Copy to .env and fill in real values. .env is gitignored; never commit it.

# --- Reverse proxy / TLS ---------------------------------------------------
# Base domain. Backend services are routed under the auth. subdomain and
# under path prefixes on the apex (<DOMAIN>/mcp/context7, /mcp/atlassian,
# /mcp/engram). Caddy issues TLS certificates for these hosts automatically;
# DNS A records must exist first.
DOMAIN=jagoqui.tech

# --- auth-gateway -----------------------------------------------------------
# 32 random bytes, base64-encoded. Used for AES-256-GCM encryption of stored
# per-user Atlassian credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATLASSIAN_ENC_KEY=

# --- mcp-context7 -----------------------------------------------------------
CONTEXT7_API_KEY=

# --- mcp-atlassian ------------------------------------------------------
# Base URL of your Atlassian site (Cloud or Server/DC). Per-user PATs are
# brokered by auth-gateway and injected per request; this is only the
# shared site URL the tool needs to know where to call.
ATLASSIAN_URL=

# --- mcp-engram-tool ----------------------------------------------------
ENGRAM_API_KEY=

# --- auth-gateway sessions ---------------------------------------------
# 32+ random bytes, used to sign HttpOnly session cookies issued by
# POST /login. Generate with:
#   openssl rand -base64 32
AUTH_GATEWAY_SESSION_SECRET=

# --- engram-cloud (`engram cloud serve`, port 18080) --------------------
# Shared team memory instance (Postgres-backed sync). Unrelated to
# engram-monitor below — different service, different API, not routed
# through Caddy.
ENGRAM_CLOUD_TOKEN=
ENGRAM_CLOUD_ADMIN=
ENGRAM_JWT_SECRET=
# Comma-separated list of project names this instance accepts sync for.
ENGRAM_CLOUD_ALLOWED_PROJECTS=

# --- engram-cloud-db (postgres backing engram-cloud) --------------------
ENGRAM_CLOUD_DB_USER=engram
ENGRAM_CLOUD_DB_PASSWORD=
ENGRAM_CLOUD_DB_NAME=engram_cloud

# --- engram-monitor -------------------------------------------------------
# Build-time only (Vite bakes this into the JS bundle — changing it
# requires rebuilding the engram-monitor image, it is NOT read at
# container runtime).
#
# NOT published through Caddy or DNS: engram-monitor's browser client
# sends no auth credentials at all, so it can't sit behind forward_auth
# (every request would 401), and the plain `engram serve` API it calls
# has no auth of its own to safely expose on the public internet instead
# (it includes delete/import/migrate endpoints). engram-monitor is
# published on the VPS's own loopback only (127.0.0.1:7438); reach it via
# an SSH tunnel of that port together with 7437 (engram serve itself,
# which this default value points at) — see README.md's "engram-monitor
# backend" section.
VITE_ENGRAM_URL=http://127.0.0.1:7437

# --- Optional: pin the engram binary release instead of resolving `latest`
# ENGRAM_VERSION=
