# Copy to .env and fill in real values. .env is gitignored; never commit it.

# --- Reverse proxy / TLS ---------------------------------------------------
# Base domain. Backend services are routed under subdomains
# (auth.<DOMAIN>, engram.<DOMAIN>) and under path prefixes on the apex
# (<DOMAIN>/mcp/context7, /mcp/atlassian, /mcp/engram). Caddy issues TLS
# certificates for these hosts automatically; DNS A records must exist first.
DOMAIN=jagoqui.tech

# --- auth-gateway -----------------------------------------------------------
# 32 random bytes, base64-encoded. Used for AES-256-GCM encryption of stored
# per-user Atlassian credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATLASSIAN_ENC_KEY=

# --- mcp-context7 -----------------------------------------------------------
CONTEXT7_API_KEY=

# --- mcp-atlassian ------------------------------------------------------
# Base URL of your Atlassian site (Cloud or Server/DC). Per-user PATs are
# brokered by auth-gateway and injected per request; this is only the
# shared site URL the tool needs to know where to call.
ATLASSIAN_URL=

# --- mcp-engram-tool ----------------------------------------------------
ENGRAM_API_KEY=

# --- auth-gateway sessions ---------------------------------------------
# 32+ random bytes, used to sign HttpOnly session cookies issued by
# POST /login. Generate with:
#   openssl rand -base64 32
AUTH_GATEWAY_SESSION_SECRET=

# --- engram-cloud (`engram cloud serve`, port 18080) --------------------
# Shared team memory instance. NOT the same run mode as the plain
# `engram serve` local API — see the VITE_ENGRAM_URL note below and
# README.md's compatibility caveat before assuming engram-monitor works
# against this instance.
ENGRAM_CLOUD_TOKEN=
ENGRAM_CLOUD_ADMIN=
ENGRAM_JWT_SECRET=
# Comma-separated list of project names this instance accepts sync for.
ENGRAM_CLOUD_ALLOWED_PROJECTS=

# --- engram-cloud-db (postgres backing engram-cloud) --------------------
ENGRAM_CLOUD_DB_USER=engram
ENGRAM_CLOUD_DB_PASSWORD=
ENGRAM_CLOUD_DB_NAME=engram_cloud

# --- engram-monitor -------------------------------------------------------
# Build-time only (Vite bakes this into the JS bundle — changing it
# requires rebuilding the engram-monitor image, it is NOT read at
# container runtime). Default points at engram-cloud's sync/dashboard API.
#
# UNVERIFIED ASSUMPTION: engram-monitor's own README/source describe it as
# a dashboard for a plain `engram serve` local API (observation search and
# browse endpoints, default http://127.0.0.1:7437). engram-cloud instead
# runs `engram cloud serve`, which per public docs only exposes /health,
# /sync/pull, /sync/push, /dashboard/* — plausibly NOT the same API shape
# engram-monitor's UI calls. This must be smoke-tested (Phase 4 / tasks.md
# 5.x); if it doesn't work, the follow-up is either a dedicated
# `engram serve` container for the monitor, or accepting engram-monitor
# isn't usable against the team-shared cloud instance.
VITE_ENGRAM_URL=http://engram-cloud:18080

# --- Optional: pin the engram binary release instead of resolving `latest`
# ENGRAM_VERSION=
